# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/nexus_core
DATABASE_USERNAME=nexus
DATABASE_PASSWORD=nexus_password

# Server Configuration
SERVER_PORT=8080

# Flyway Configuration (optional overrides)
# FLYWAY_LOCATIONS=classpath:db/migration
# FLYWAY_BASELINE_ON_MIGRATE=true

# Logging Configuration (optional overrides)
# LOGGING_LEVEL_COM_TECHTUNE_NEXUS=DEBUG
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
# LOGGING_LEVEL_ORG_HIBERNATE_SQL=DEBUG

# Management/Actuator Configuration (optional overrides)
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
# MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized
